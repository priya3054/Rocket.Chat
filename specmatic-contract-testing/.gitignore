# Every file written by regenerate-auth-examples.sh carries a live,
# per-container-boot auth token or other seeded live-instance data --
# regenerated before each test run, never committed. login.json is the
# one example that's hand-maintained with placeholder-only data (the
# spec's own public example values) and stays committed.
specmatic/examples/*
!specmatic/examples/login.json
specmatic/reports/
